NODE_ENV=development

# Required
BOT_TOKEN=
BOT_CLIENT_ID=

# Optional — dev only: instant guild slash sync (leave empty in production)
BOT_GUILD_ID=

# Defaults for new guilds (lazy-init uses mode 2 regardless until admin changes)
SCAM_ACTION=1
PHASH_THRESHOLD=8
PHASH_STRICT_THRESHOLD=3
TIMEOUT_DURATION_SECONDS=3600
# Central log hub (main guild) — receives detections from every server
LOG_CHANNEL_ID=

DATABASE_PATH=./data/scam-lens.db

# Comma-separated Discord user IDs
OWNER_IDS=

# Fork-friendly repo URL for /about button
GITHUB_REPO_URL=https://github.com/vorlaxen/scam-lens-discord-bot

# Rotating rich presence (bot profile status)
PRESENCE_ENABLED=true
PRESENCE_ROTATE_MS=45000

# Sync OAuth install link for the profile "Add App" button
INSTALL_SYNC_ENABLED=true
# Optional override — otherwise built from BOT_CLIENT_ID
# BOT_INVITE_URL=

# Roadmap — not implemented (single SQLite process today)
# REDIS_ENABLED=false
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_PREFIX=scam-lens:
