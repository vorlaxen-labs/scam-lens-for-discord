{
  "name": "scam-lens-discord-bot",
  "version": "0.1.0",
  "description": "Self-hosted Discord scam and phishing detection bot. Scam images via perceptual hash (pHash) and phishing domains via blocklist.",
  "keywords": [
    "discord",
    "discord-bot",
    "discord.js",
    "scam-detection",
    "phishing",
    "anti-scam",
    "moderation",
    "phash",
    "sqlite",
    "self-hosted"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vorlaxen-labs/scam-lens-for-discord.git"
  },
  "bugs": {
    "url": "https://github.com/vorlaxen-labs/scam-lens-for-discord/issues"
  },
  "homepage": "https://github.com/vorlaxen-labs/scam-lens-for-discord#readme",
  "type": "module",
  "author": "Vorlaxen Labs",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "imports": {
    "#/*": "./dist/*"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/infra/bootstrap/index.ts",
    "start": "node dist/infra/bootstrap/index.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:scenarios": "vitest run tests/scenarios",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "pnpm typecheck && pnpm test:coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/infra/database/migrate.ts",
    "deploy-commands": "tsx src/scripts/deploy-commands.ts",
    "build:image-dataset": "tsx src/scripts/build-image-dataset.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "imghash": "^1.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.33.5",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
