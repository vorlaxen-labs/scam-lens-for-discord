{
  "name": "scam-lens-discord-bot",
  "version": "0.1.0",
  "description": "Discord scam detection bot — pHash images + domain blocklist",
  "type": "module",
  "author": "Vorlaxen",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "imports": {
    "#/*": "./dist/*"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/infra/bootstrap/index.ts",
    "start": "node dist/infra/bootstrap/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/infra/database/migrate.ts",
    "deploy-commands": "tsx src/scripts/deploy-commands.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "imghash": "^1.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.33.5",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
